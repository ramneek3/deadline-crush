PORT=4000
MONGO_URL=mongodb://127.0.0.1:27017/deadline_crush
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:5173

# S3-compatible storage (MinIO locally, Cloudflare R2 in production)
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_BUCKET=submissions
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Deadline policy (first boot only; the organizer can change it afterwards)
DEADLINE_AT=2026-11-30T18:30:00.000Z
GRACE_SECONDS=300
